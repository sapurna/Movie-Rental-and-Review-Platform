<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<footer class="cinevora-footer">
    <div class="container">
        <div class="row g-4 align-items-start">
            <div class="col-md-5">
                <div class="cinevora-footer-brand">
                    <i class="fa-solid fa-clapperboard me-2" aria-hidden="true"></i>Cinevora
                </div>
                <p class="cinevora-footer-text mt-2 mb-0">
                    Discover films, book your seats, and share reviews with a community of movie lovers.
                </p>
            </div>
            <div class="col-md-3 col-6">
                <h2 class="cinevora-footer-heading">Explore</h2>
                <ul class="cinevora-footer-links list-unstyled mb-0">
                    <li><a href="${ctx}/movies">Movies</a></li>
                    <li><a href="${ctx}/bookings">My Bookings</a></li>
                    <li><a href="${ctx}/profile">Profile</a></li>
                </ul>
            </div>
            <div class="col-md-4 col-6">
                <h2 class="cinevora-footer-heading">Support</h2>
                <ul class="cinevora-footer-links list-unstyled mb-0">
                    <li><a href="mailto:support@cinevora.com">support@cinevora.com</a></li>
                    <li><span class="cinevora-footer-muted">Colombo, Sri Lanka</span></li>
                </ul>
            </div>
        </div>
        <hr class="cinevora-footer-divider">
        <p class="cinevora-footer-copy text-center mb-0">&copy; 2026 Cinevora. All rights reserved.</p>
    </div>
</footer>
